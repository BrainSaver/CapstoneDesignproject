  eventImage: {fileID: 21300000, guid: 5beb721ff29b09a48964e828bcd6455f, type: 3}
  eventText: "\uCE60\uD751\uAC19\uC774 \uC5B4\uB450\uC6B4 \uC885\uB8E8 \uBC14\uB2E5\uC5D0
